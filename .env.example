# Database Configuration (keep sensitive data private!)
DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_secure_password_here
DB_DATABASE=attendance
DB_PORT=3306
DB_SSL_CA=path/to/ca-certificate.pem

# Google OAuth Configuration (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Session Configuration (generate a strong random string)
SESSION_SECRET=generate_a_long_random_string_with_mix_of_uppercase_lowercase_numbers_symbols

# Environment
NODE_ENV=development

# Security
ALLOWED_IP=your_office_ip_address
ALLOWED_ISP_NAME=your_isp_name
